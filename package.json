{
  "name": "xeno-rift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "check-levels": "node scripts/check-levels.ts",
    "cap:sync": "npm run build && cap sync android",
    "e2e": "node tests/e2e/run.mjs",
    "test": "npm run typecheck && npm run check-levels && node tests/e2e/run.mjs --suite smoke"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@fontsource/exo-2": "5.3.0",
    "@fontsource/orbitron": "5.3.0",
    "phaser": "3.90.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/three": "0.186.0",
    "playwright-core": "1.55.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
